{
  "expo": {
    "name": "CarService1",
    "slug": "carservice1",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "carservice1",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#00A859"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.autoduck.carservice1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to attach photos of your vehicle.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos of your vehicle."
      }
    },
    "android": {
      "package": "com.autoduck.carservice1",
      "adaptiveIcon": {
        "backgroundColor": "#00A859"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#00A859"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
